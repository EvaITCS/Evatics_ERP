# Copy to .env, then:  set -a && source .env && set +a
#
# project/region come from the repo root .env (source that first - it
# already has TF_VAR_project/TF_VAR_region, shared across bootstrap and
# both envs). This file only holds the one value that must differ between
# envs/dev and envs/prod.

TF_VAR_environment=dev
